# Server Port
PORT=3000

# PostgreSQL Connection String (DATABASE_URL)
#
# Option A (Live Cloud - Neon - Recommended Free PostgreSQL):
# DATABASE_URL=postgresql://neondb_owner:YOUR_PASSWORD@ep-sample-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
#
# Option B (Live Cloud - Supabase):
# DATABASE_URL=postgresql://postgres.yourprojectref:YOUR_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require
#
# Option C (Live Cloud - Render):
# DATABASE_URL=postgresql://username:password@dpg-xxxx.oregon-postgres.render.com/college_election?sslmode=require
#
# Option D (Live Cloud - Aiven):
# DATABASE_URL=postgres://avnadmin:YOUR_PASSWORD@pg-your-host.aivencloud.com:23833/defaultdb?sslmode=require
#
# Option E (Local Development):
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_election

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/college_election

# Secret key for signing JWT tokens (generate a long random secret in production)
JWT_SECRET=replace_with_a_secure_random_secret_key_123456
